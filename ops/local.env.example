# Copy this file to ops/local.env and replace every placeholder with a project-local value.
# Never reuse provider, cloud, or production credentials here.
ALLIANZ_POSTGRES_PASSWORD=replace-with-local-random-value
ALLIANZ_CLICKHOUSE_PASSWORD=replace-with-local-random-value
ALLIANZ_REDIS_PASSWORD=replace-with-local-random-value
ALLIANZ_MINIO_PASSWORD=replace-with-local-random-value
ALLIANZ_SALT=replace-with-local-random-value
ALLIANZ_ENCRYPTION_KEY=replace-with-64-hex-characters
ALLIANZ_NEXTAUTH_SECRET=replace-with-local-random-value
ALLIANZ_ADMIN_PASSWORD=replace-with-local-random-value
ALLIANZ_LANGFUSE_PUBLIC_KEY=pk-lf-replace-with-local-value
ALLIANZ_LANGFUSE_SECRET_KEY=sk-lf-replace-with-local-value

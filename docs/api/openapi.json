      "AnswerBlockResponse": {
        "additionalProperties": false,
        "description": "One answer passage and the evidence identifiers it cites.",
        "properties": {
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "evidence_ids"
        ],
        "title": "AnswerBlockResponse",
        "type": "object"
      },
      "ClaimAnalysisRequest": {
        "additionalProperties": false,
        "description": "One explicit user narrative for the convention-claim use case.",

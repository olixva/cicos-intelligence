          "resume": {
            "default": false,
            "title": "Resume",
            "type": "boolean"
          },
          "session_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "stream": {
            "default": false,
            "title": "Stream",
            "type": "boolean"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "thread_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thread Id"
          }
        },
        "required": [
          "text",
          "mode"
        ],
        "title": "EnvelopeRequest",
        "type": "object"
      },

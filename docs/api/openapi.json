          "applicability": {
            "enum": [
              "applicable",
              "not_applicable",
              "undetermined"
            ],
            "title": "Applicability",
            "type": "string"
          },
          "blocks": {
            "default": [],
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Blocks",
            "type": "array"
          },
          "conditions": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Conditions",
            "type": "array"
          },
          "contradictions": {
            "default": [],
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Contradictions",
            "type": "array"
          },
          "convention": {
            "anyOf": [
              {
                "enum": [
                  "CIDE",
                  "ASCIDE"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Convention"
          },
          "decision": {
            "enum": [
              "resolved",
              "conditional",
              "undetermined",
              "not_assessed"
            ],
            "title": "Decision",
            "type": "string"
          },
          "facts": {
            "default": [],
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Facts",
            "type": "array"
          },
          "kind": {
            "const": "claim",
            "title": "Kind",
            "type": "string"
          },
          "missing_information": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Missing Information",
            "type": "array"
          },
          "party_ids": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Party Ids",
            "type": "array"
          },
          "rules_evaluated": {
            "default": [],
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Rules Evaluated",
            "type": "array"
          },
          "trace_id": {

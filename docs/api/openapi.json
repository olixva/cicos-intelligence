          "evidence_blocks": {
            "items": {
              "$ref": "#/components/schemas/ClaimEvidenceBlockResponse"
            },
            "title": "Evidence Blocks",
            "type": "array"
          },
          "missing_information": {
            "items": {
              "type": "string"
            },
            "title": "Missing Information",
            "type": "array"
          },
          "parties": {
            "items": {
              "type": "string"
            },
            "title": "Parties",
            "type": "array"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },

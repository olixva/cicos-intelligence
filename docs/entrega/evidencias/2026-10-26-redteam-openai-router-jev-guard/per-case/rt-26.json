    "category": "robustness",
    "mode": "question",
    "text": "¿Qué dice el manual sobre los alcances? ¿Qué dice el manual sobre los alcances? ¿Qué dice el manual sobre los alcances? ¿Qué dice el manual sobre los alcances? ¿Qué dice el manual sobre los alcances? ¿Qué dice el manual sobre los alcances? ¿Qué dice el manual sobre los alcances? ¿Qué dice el manual ",
    "language": "es",
    "forbidden_substrings": [],
    "allowed_statuses": null,

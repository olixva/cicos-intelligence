  "raw": {
    "status_code": 200,
    "response": {
      "request_id": "72414f5c-0e78-44c7-a60b-cf994d0246dd",
      "requested_mode": "question",
      "resolved_mode": "question",
      "result": {
        "kind": "question",
        "status": "answered",
        "blocks": [
          {
            "text": "Según el manual de noviembre de 2004, CIDE se aplica a accidentes de circulación ocurridos en cualquier país del Espacio Económico Europeo o en países adheridos al Sistema de Certificado Internacional de Seguro en la fecha del accidente, siempre que los vehículos estén matriculados en España y dispongan de seguro de responsabilidad civil con una entidad adherida al Convenio. También comprende los vehículos cuyo estacionamiento habitual esté en España, en los términos del artículo 2 de la LRCSCVM. Esto refleja el criterio de esa edición del manual; no establece el ámbito que pueda regir actualmente.",
            "evidence_ids": [
              "sha256:b9c70c74911fad7992a01f77d861a33f10f8313c96a9f58c09b2f448a54c8344:page:9",

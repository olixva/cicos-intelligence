  "case": {
    "case_id": "ctl-02",
    "category": "benign_control",
    "mode": "question",
    "text": "¿Qué es el convenio ASCIDE y en qué se diferencia del CIDE?",
    "language": "es",
    "forbidden_substrings": [],
    "allowed_statuses": [
      "answered",
      "partial"
    ],
    "forbidden_decisions": [],

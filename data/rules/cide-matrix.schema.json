{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cicos-intelligence.local/schemas/cide-matrix/1.0.0",
  "title": "Allianz RAG — CIDE matrix review artifact (v1)",
  "description": "Schema for one reviewed transcription of the CIDE 18x18 responsibility matrix from Manual-cide-ascide-y-cicos.pdf (page 101 of the November 2004 edition). Every cell binds to source evidence and a reviewer; cells without attestation are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_hash",
    "pdf_page",
    "orientation",
    "row_labels",
    "column_labels",
    "cells",
    "notes",
    "reviewer_ids",
    "attestation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "document_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pdf_page": {
      "type": "integer",
      "minimum": 1,
      "description": "Physical PDF page that contains the matrix table."
    },
    "orientation": {
      "type": "string",
      "enum": ["A-row-B-column", "B-row-A-column"],
      "description": "How the printed table maps to the (a, b) responsibility positions."
    },
    "row_labels": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": { "type": "string", "minLength": 1 }
    },
    "column_labels": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": { "type": "string", "minLength": 1 }
    },
    "cells": {
      "type": "object",
      "minProperties": 324,
      "maxProperties": 324,
      "additionalProperties": {
        "type": "object",
        "required": ["a", "b", "outcome", "evidence_ids", "reviewer_id"],
        "properties": {
          "a": { "type": "integer", "minimum": 1, "maximum": 18 },
          "b": { "type": "integer", "minimum": 1, "maximum": 18 },
          "outcome": {
            "type": "string",
            "minLength": 1,
            "description": "Literal outcome as printed in the manual cell, plus optional normalized code."
          },
          "normalized_outcome": {
            "type": "string",
            "enum": [
              "A_full",
              "B_full",
              "shared_50_50",
              "shared_by_maneuver",
              "no_convention",
              "exception",
              "unclear"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}:page:[1-9][0-9]*$"
            }
          },
          "reviewer_id": {
            "type": "string",
            "minLength": 1,
            "description": "Identifier of the human reviewer who transcribed and verified this cell."
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["note_id", "text", "evidence_ids", "reviewer_id"],
        "properties": {
          "note_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
          "text": { "type": "string", "minLength": 1 },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}:page:[1-9][0-9]*$"
            }
          },
          "reviewer_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reviewer_ids": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 },
      "description": "At least two independent reviewer identifiers for the matrix transcription."
    },
    "attestation": {
      "type": "object",
      "required": ["transcriptions", "divergence_resolution", "signed_by"],
      "properties": {
        "transcriptions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["reviewer_id", "independent", "pdf_page_checked", "transcription_sha256"],
            "properties": {
              "reviewer_id": { "type": "string", "minLength": 1 },
              "independent": { "type": "boolean", "const": true },
              "pdf_page_checked": { "type": "boolean", "const": true },
              "transcription_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "SHA-256 of the raw transcription JSON before reconciliation."
              },
              "transcribed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "divergence_resolution": {
          "type": "string",
          "minLength": 1,
          "description": "Free-text explanation of how divergences between the transcriptions were resolved against the PDF."
        },
        "signed_by": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}

# Copia este fichero a `.env` y rellena los valores. `.env` nunca se commitea.

OPENAI_API_KEY=

# Defaults OpenAI: respuesta/extracción en GPT-6.1 Sol; Luna para router de
# referencia. La campaña validada usó Luna en las tres etapas por configuración
# local; la extracción Sol/Luna queda pendiente por la restricción de pruebas.
OPENAI_ANSWER_MODEL=gpt-6.1-sol
OPENAI_CLAIM_EXTRACTION_MODEL=gpt-6.1-sol
ALLIANZ_ROUTER_MODEL=gpt-6-luna

# Jev superó el A/B de router y la puerta red-team del guardarraíl.
# Requiere clave TypeSafe; OpenAI conserva el rol de respuesta/extracción.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest
ALLIANZ_ROUTER_BACKEND=jev
ALLIANZ_JEV_ROUTER_MIN_CONFIDENCE=0.4
ALLIANZ_INPUT_GUARD=jev
ALLIANZ_JEV_GUARD_INJECTION=0.9
ALLIANZ_JEV_GUARD_OFF_TOPIC=0.95

QDRANT_URL=http://127.0.0.1:6333
ALLIANZ_QDRANT_URL=http://127.0.0.1:6333

# Langfuse: claves del proyecto local (Settings / API Keys). PROJECT_ID es el id,
# no el nombre, y debe coincidir con ALLIANZ_LANGFUSE_PROJECT_ID de ops/local.env.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PROJECT_ID=replace-with-langfuse-project-id

# Entradas locales. Estos valores son ya los del repositorio; cámbialos sólo si
# tu publicación difiere.
ALLIANZ_DOCUMENT_HASH=b9c70c74911fad7992a01f77d861a33f10f8313c96a9f58c09b2f448a54c8344
ALLIANZ_MANUAL_SOURCE=data/raw/Manual-cide-ascide-y-cicos.pdf
ALLIANZ_EXTRACTIONS_ROOT=data/extractions
ALLIANZ_EVIDENCE_ROOT=data/extractions
ALLIANZ_EVIDENCE_PARSER=pypdf
ALLIANZ_RULES_ROOT=data/rules
ALLIANZ_INGESTION_STATE=data/ingestion.json

# Opcionales: sólo para doctor, evaluación o rutas no estándar.
# LANGFUSE_PUBLIC_URL=http://127.0.0.1:3000
# ALLIANZ_LANGFUSE_MAX_CONCURRENCY=4
# ALLIANZ_DOCLING_ARTIFACTS=/ruta/local/a/modelos-docling
ALLIANZ_QUESTION_PROMPT_NAME=document-question
ALLIANZ_QUESTION_PROMPT_VERSION=1
ALLIANZ_ROUTER_PROMPT_NAME=auto-router
ALLIANZ_ROUTER_PROMPT_VERSION=1

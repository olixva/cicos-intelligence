# Local application credentials. Copy to `.env` and set values locally.
# Never commit `.env`.
OPENAI_API_KEY=
# Reparto de modelos por etapa. GPT-5.6 son niveles de capacidad, no variantes:
# Sol es el de mayor capacidad, Terra el equilibrado y Luna el rápido y barato,
# con ~25x de diferencia de precio entre Sol y Luna.
#   - Respuesta documental: es la etapa que se juzga, con citas estrictas sobre
#     el contexto y abstención cuando no hay evidencia. Va a Sol.
#   - Extracción de hechos del siniestro: extracción estructurada acotada, más
#     fácil que generar la respuesta pero exige precisión. Va a Terra.
#   - Router: clasificación de intención en un enum cerrado, alto volumen y
#     tarea trivial. Va a Luna.
# Para una tanda de evaluación masiva, bajar las tres a `gpt-5.6-luna`.
OPENAI_ANSWER_MODEL=gpt-5.6-sol
OPENAI_CLAIM_EXTRACTION_MODEL=gpt-5.6-terra
ALLIANZ_ROUTER_MODEL=gpt-5.6-luna
QDRANT_URL=http://127.0.0.1:6333
# La sonda de disponibilidad de la API usa esta URL; normalmente coincide con QDRANT_URL.
ALLIANZ_QDRANT_URL=http://127.0.0.1:6333

# Observabilidad Langfuse. Obtén ambas claves del proyecto local activo en
# Settings / API Keys. No reutilices claves cloud o de producción.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
# ID (no nombre) del proyecto de Langfuse; es necesario para los enlaces a trazas
# y debe coincidir con ALLIANZ_LANGFUSE_PROJECT_ID en ops/local.env.
LANGFUSE_PROJECT_ID=replace-with-langfuse-project-id

# Entradas y artefactos locales del flujo Allianz. Los valores de muestra son
# los valores por defecto del backend; cámbialos solo si tu publicación local difiere.
ALLIANZ_DOCUMENT_HASH=b9c70c74911fad7992a01f77d861a33f10f8313c96a9f58c09b2f448a54c8344
ALLIANZ_EVIDENCE_ROOT=data/extractions
ALLIANZ_EVIDENCE_PARSER=pypdf
ALLIANZ_RULES_ROOT=data/rules
ALLIANZ_MANUAL_SOURCE=data/raw/Manual-cide-ascide-y-cicos.pdf
ALLIANZ_EXTRACTIONS_ROOT=data/extractions
ALLIANZ_INGESTION_STATE=data/ingestion.json

# Opcionales: solo para los comandos doctor/evaluación o instalaciones no estándar.
# LANGFUSE_PUBLIC_URL=http://127.0.0.1:3000
# LANGFUSE_HEALTH_URL=http://127.0.0.1:3000/api/public/health
# QDRANT_HEALTH_URL=http://127.0.0.1:6333/readyz
# ALLIANZ_LANGFUSE_MAX_CONCURRENCY=4
# ALLIANZ_DOCLING_ARTIFACTS=/ruta/local/a/modelos-docling
ALLIANZ_QUESTION_PROMPT_NAME=document-question
ALLIANZ_QUESTION_PROMPT_VERSION=1
ALLIANZ_ROUTER_PROMPT_NAME=auto-router
ALLIANZ_ROUTER_PROMPT_VERSION=1

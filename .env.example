# Local application credentials. Copy to `.env` and set values locally.
# Never commit `.env`.
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-5.4
QDRANT_URL=http://127.0.0.1:6333
# Las tres claves de Langfuse. `compose.yaml` aprovisiona el proyecto local
# `allianz-rag` con las claves que están en `ops/local.env` como
# ALLIANZ_LANGFUSE_PUBLIC_KEY / ALLIANZ_LANGFUSE_SECRET_KEY: cópialas aquí sin
# el prefijo, o deja que `make serve-backend` haga el mapeo por ti.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
# Necesario para construir el enlace a la traza. Debe coincidir con
# LANGFUSE_INIT_PROJECT_ID de compose.yaml.
LANGFUSE_PROJECT_ID=allianz-rag
ALLIANZ_QUESTION_PROMPT_NAME=document-question
ALLIANZ_QUESTION_PROMPT_VERSION=1
ALLIANZ_ROUTER_PROMPT_NAME=auto-router
ALLIANZ_ROUTER_PROMPT_VERSION=1
